# --- App ---
APP_NAME=OmniDesk AI
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Database ---
POSTGRES_USER=omnidesk
POSTGRES_PASSWORD=omnidesk
POSTGRES_DB=omnidesk
DATABASE_URL=postgresql+asyncpg://omnidesk:omnidesk@postgres:5432/omnidesk
SYNC_DATABASE_URL=postgresql+psycopg2://omnidesk:omnidesk@postgres:5432/omnidesk

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth ---
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
OPENAI_API_KEY=

# --- Storage ---
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
UPLOAD_DIR=/app/uploads

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@omnidesk.ai

# --- Channels ---
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
TELEGRAM_BOT_TOKEN=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
